# ============================================================================
# zhenyun-pangun-mcp 配置示例（复制为 .env 后填写真实值）
# 本 MCP 完全自包含，无需任何外部仓库目录。
# ============================================================================

# ---------------------------------------------------------------------------
# 跨仓代码搜索根目录（纯本地文件遍历，默认回退到本仓库根）
# ---------------------------------------------------------------------------
PG_ROOT=/path/to/pangu-root

# ---------------------------------------------------------------------------
# Archery 数据库（双站点）
# ---------------------------------------------------------------------------
# 真实网关（默认即真实地址，一般无需修改）
# ARCHERY_BASE_URL=https://archery.cn-saas-1.tygo.going-link.net
# ARCHERY_AWS_BASE_URL=https://archery.jp-saas-1.going-link.net
ARCHERY_USERNAME=
ARCHERY_PASSWORD=
ARCHERY_AWS_USERNAME=
ARCHERY_AWS_PASSWORD=
# 实例别名 -> 真实 Archery 实例名（可选覆盖）
# cn 站点实例名对齐上游；aws 站点为日本云(JP-SaaS-1)独立实例，当前仅一个正式环境
ARCHERY_DB_CN=SAAS-SRM-PROD数据库
ARCHERY_DB_AWS=JP-SaaS-1-Prod-RW-8.0
ARCHERY_DB_AWS_RO=JP-SaaS-1-Prod-RW-8.0
ARCHERY_DB_DEV=SAAS-SRM-DEV数据库
ARCHERY_DB_TEST=SAAS-SRM-TEST数据库
# 默认库（可选）
ARCHERY_DEFAULT_DB=srm

# ---------------------------------------------------------------------------
# Loki 日志（双平台）
# ---------------------------------------------------------------------------
# AWS 海外（jp-saas-1）
LOKI_API_BASE_AWS=https://logs.jp-saas-1.going-link.net
AWS_LOG_USERNAME=
AWS_LOG_PASSWORD=
# 国内公有云（非 prod 已切换至此）
LOKI_API_BASE_CN=https://logs.going-link.net
CN_LOG_USERNAME=
CN_LOG_PASSWORD=

# Loki 环境 -> 数据源名
AWS_LOG_DS_PROD=Jp-saas-1-prod
AWS_LOG_DS_NONPROD=Jp-saas-1-noneprod
AWS_LOG_DS_OPS=ops
# cn 国内公有云（Grafana 盘古面板：盘古非生产 -> Loki (pangu-noneprod)）
CN_LOG_DS_PROD=Loki (dify-prod)
CN_LOG_DS_NONPROD=Loki (pangu-noneprod)
CN_LOG_DS_OPS=Loki (tygo-noneprod)

# ---------------------------------------------------------------------------
# 阿里云 SLS（盘古正式环境日志 = 阿里云日志服务；复刻自 log-ops-mcp）
# ---------------------------------------------------------------------------
SLS_PANGU_NONPROD_ACCESS_KEY_ID=
SLS_PANGU_NONPROD_ACCESS_KEY_SECRET=
SLS_PANGU_PROD_ACCESS_KEY_ID=
SLS_PANGU_PROD_ACCESS_KEY_SECRET=
SLS_ENDPOINT=cn-shanghai.log.aliyuncs.com

# ---------------------------------------------------------------------------
# 猪齿鱼 Choerodon（内置 Python 客户端，四步纯 HTTP 登录，无浏览器/验证码）
# 基址必须是真实网关 open-gateway.going-link.com（不要填 code.choerodon.com.cn）
# ---------------------------------------------------------------------------
CHOERODON_BASE_URL=https://open-gateway.going-link.com
CHOERODON_ORG_ID=1
CHOERODON_TENANT_ID=1
# 默认项目 ID（搜索/详情默认项目，可按需覆盖）。生产项目 58 的 detail 接口实测可用；
# 敏捷项目 738424127719677952 的 detail 解密不兼容，勿用。
CHOERODON_PROJECT_ID=58
CHOERODON_USERNAME=
CHOERODON_PASSWORD=
# 本地 token 缓存路径（可选覆盖，默认 ~/.choerodon_token.json）
CHOERODON_TOKEN_CACHE=
